<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Clean Light theme for college project (consistent day and night) -->
    <style name="Base.Theme.GymSync" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purple_light</item>
        <item name="colorOnPrimaryContainer">@color/purple_primary</item>

        <item name="colorSecondary">@color/purple_primary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>